DB_HOST=127.0.0.1
DB_NAME=healinghorizon
DB_USER=root
DB_PASS=

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

FRONTEND_ORIGIN=http://localhost:5173

# 8x8 JaaS (Jitsi-as-a-Service) video rooms
JAAS_APP_ID=vpaas-magic-cookie-your-app-id
JAAS_KEY_ID=vpaas-magic-cookie-your-app-id/your-key-id
# Path to the downloaded RSA private key (.pk). Never commit the key itself.
JAAS_PRIVATE_KEY_PATH=jaas-private-key.pk

# Optional: LLM API for AI Chatbot. Leave blank for canned replies.
# LLM_API_KEY=sk-your-key-here
# LLM_API_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-pro
